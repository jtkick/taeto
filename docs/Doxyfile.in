# This file is processed by CMake to generate the final Doxyfile

PROJECT_NAME           = "@PROJECT_NAME@"
PROJECT_BRIEF          = "A terminal animation engine."
PROJECT_LOGO           =

OUTPUT_DIRECTORY       = "@CMAKE_BINARY_DIR@/html_docs"
INPUT                  = "@CMAKE_SOURCE_DIR@/docs" "@CMAKE_SOURCE_DIR@/src" "@CMAKE_SOURCE_DIR@/include"

FILE_PATTERNS          = *.dox *.hpp *.cpp
RECURSIVE              = YES
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES

GENERATE_HTML          = YES
GENERATE_LATEX         = NO

# Graphviz settings
HAVE_DOT               = YES
DOT_PATH               = ""
UML_LOOK               = YES